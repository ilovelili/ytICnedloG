# RPC endpoint for the Ethereum-compatible network
RPC_URL=http://127.0.0.1:8545

# Private key of the contract owner (use one of Hardhat node accounts for local testing)
OWNER_PRIVATE_KEY=

# Shared secret required in the x-owner-secret header to access POST /candidates
OWNER_SECRET=super-secret

# Port for the Express backend
PORT=4000
